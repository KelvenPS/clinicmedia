generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  SECRETARY
}

enum PatientStatus {
  PRE_CADASTRO
  ATIVO
  INCOMPLETO
  INATIVO
}

enum PatientOrigin {
  AGENDA
  CHATBOT
  MANUAL
  IMPORTACAO
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum PlanType {
  PARTICULAR
  CONVENIO
  OUTROS
}

enum RecordType {
  ANAMNESE
  EVOLUCAO
  PRESCRICAO
  EXAME
  ATESTADO
  OUTROS
}

enum AssessmentType {
  WISC_IV
  WASI
  WAIS_III
  COGNITIVA
  RAVLT
}

enum IntegrationType {
  WEBHOOK
  GOOGLE_CALENDAR
  GOOGLE_GMAIL
  WHATSAPP
  AI_AGENT
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(SECRETARY)
  active           Boolean   @default(true)
  specialty        String?
  certType         String?
  certNumber       String?
  crm              String?
  phone            String?
  avatarUrl        String?
  bio              String?
  lunchStart       String?
  lunchEnd         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  patients             Patient[]                   @relation("DoctorPatients")
  doctorAppointments   Appointment[]               @relation("DoctorAppointments")
  createdAppointments  Appointment[]               @relation("CreatedByAppointments")
  transactions         Transaction[]
  medicalRecords       MedicalRecord[]             @relation("DoctorRecords")
  appointmentBlocks    AppointmentBlock[]          @relation("DoctorBlocks")
  assessments          Assessment[]                @relation("DoctorAssessments")
  doctorTeam           DoctorSecretary[]           @relation("DoctorTeam")
  secretaryOf          DoctorSecretary[]           @relation("SecretaryOf")
  rooms                Room[]                      @relation("DoctorRooms")
  roomAssignments      RoomSecretary[]             @relation("SecretaryRooms")
  documentTemplates    DocumentTemplate[]          @relation("DoctorDocuments")
  notifications        Notification[]              @relation("UserNotifications")
  paymentMethods       PaymentMethod[]             @relation("DoctorPaymentMethods")
  subscription         DoctorSubscription?         @relation("DoctorSubscription")
  subscriptionPayments SubscriptionPayment[]       @relation("DoctorPayments")
  integrations         Integration[]               @relation("DoctorIntegrations")
  whatsappInstances    WhatsAppInstance[]          @relation("DoctorWhatsApp")
  healthPlans          HealthPlan[]                @relation("DoctorHealthPlans")
  appointmentTypes     AppointmentType[]           @relation("DoctorAppointmentTypes")
  sqlLogs              SqlQueryLog[]               @relation("AdminSqlLogs")
  lightTemplates       LightTemplate[]             @relation("DoctorLightTemplates")
  lightIntegrations    LightIntegrationConfig[]    @relation("DoctorLightIntegrations")
  lightLogs            LightMessageLog[]           @relation("DoctorLightLogs")
  lightSettings        LightSettings?              @relation("DoctorLightSettings")
  lightFluxos          LightFluxo[]                @relation("DoctorLightFluxos")
  lightQuickReplies    LightQuickReply[]           @relation("DoctorLightQuickReplies")
  lightChatbots        LightChatbot[]              @relation("DoctorLightChatbots")
  roomWAConnections    RoomWhatsAppConnection[]    @relation("DoctorRoomConnections")
  roomWAConnectedBy    RoomWhatsAppConnection[]    @relation("RoomWAConnectedBy")
  patientsCreated      Patient[]                   @relation("PatientCreatedBy")
  patientsCompleted    Patient[]                   @relation("PatientCompletedBy")
  financialCategories  FinancialCategory[]         @relation("DoctorFinancialCategories")
  costCenters          CostCenter[]                @relation("DoctorCostCenters")
  bankAccounts         BankAccount[]               @relation("DoctorBankAccounts")
  lightNotifTemplates  LightNotificationTemplate[] @relation("DoctorLightNotifTemplates")

  @@map("TBLUSUARIO")
}

model DoctorSecretary {
  id          String   @id @default(uuid())
  doctorId    String
  secretaryId String
  active      Boolean  @default(true)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())

  doctor    User @relation("DoctorTeam", fields: [doctorId], references: [id])
  secretary User @relation("SecretaryOf", fields: [secretaryId], references: [id])

  @@unique([doctorId, secretaryId])
  @@map("TBLMEDICOSECRETARIA")
}

model Patient {
  id                String        @id @default(uuid())
  doctorId          String?
  name              String
  email             String?
  phone             String
  birthDate         DateTime?
  cpf               String?       @unique
  rg                String?
  address           String?
  notes             String?
  responsibleName   String?
  responsiblePhone  String?
  active            Boolean       @default(true)
  status            PatientStatus @default(ATIVO)
  origin            PatientOrigin @default(MANUAL)
  roomId            String?
  createdByUserId   String?
  completedByUserId String?
  completedAt       DateTime?
  chatbotSessionId  String?       @unique
  // Pipeline de lead do Chatbot Light — independente de `status`/PatientStatus
  // (usado pelo resto do sistema). Só relevante quando origin: CHATBOT.
  // Valores: NOVO | EM_ANALISE | CONVERTIDO | DESCARTADO
  leadStatus        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  doctor          User?             @relation("DoctorPatients", fields: [doctorId], references: [id])
  createdByUser   User?             @relation("PatientCreatedBy", fields: [createdByUserId], references: [id])
  completedByUser User?             @relation("PatientCompletedBy", fields: [completedByUserId], references: [id])
  room            Room?             @relation("RoomPatients", fields: [roomId], references: [id])
  chatbotSession  LightFlowSession? @relation("ChatbotSessionPatient", fields: [chatbotSessionId], references: [id])
  appointments    Appointment[]
  patientPlans    PatientPlan[]
  medicalRecords  MedicalRecord[]
  assessments     Assessment[]

  @@index([doctorId])
  @@index([status])
  @@index([origin])
  @@index([chatbotSessionId])
  @@index([leadStatus])
  @@map("TBLPACIENTE")
}

model HealthPlan {
  id              String   @id @default(uuid())
  doctorId        String?
  roomId          String?
  name            String
  type            PlanType @default(PARTICULAR)
  customTypeName  String?
  description     String?
  discountPercent Float?
  defaultValue    Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor       User?         @relation("DoctorHealthPlans", fields: [doctorId], references: [id])
  room         Room?         @relation("RoomHealthPlans", fields: [roomId], references: [id])
  patientPlans PatientPlan[]

  @@map("TBLPLANOSAUDE")
}

model PatientPlan {
  id           String    @id @default(uuid())
  patientId    String
  healthPlanId String
  value        Float?
  walletNumber String?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id])

  @@unique([patientId, healthPlanId])
  @@map("TBLPACIENTEPLANO")
}

model AppointmentBlock {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  doctor User @relation("DoctorBlocks", fields: [doctorId], references: [id])

  @@map("TBLBLOQUEIOAGENDA")
}

model MedicalRecord {
  id            String     @id @default(uuid())
  patientId     String
  doctorId      String
  title         String
  content       String
  type          RecordType @default(EVOLUCAO)
  date          DateTime   @default(now())
  specialtyType String?
  specialtyData Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation("DoctorRecords", fields: [doctorId], references: [id])

  @@map("TBLPRONTUARIO")
}

model Assessment {
  id              String         @id @default(uuid())
  patientId       String
  doctorId        String
  type            AssessmentType
  assessDate      DateTime       @default(now())
  patientAge      Int?
  subtestScores   Json           @default("{}")
  compositeScores Json           @default("{}")
  interpretation  String?
  notes           String?
  status          String         @default("DRAFT")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation("DoctorAssessments", fields: [doctorId], references: [id])

  @@map("TBLAVALIACAO")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  createdById     String
  roomId          String?
  title           String
  date            DateTime
  duration        Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  isBlocked       Boolean           @default(false)
  notes           String?
  type            String?
  value           Float?
  billedAt        DateTime?
  reminder24hSent Boolean           @default(false)
  reminder2hSent  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      User         @relation("DoctorAppointments", fields: [doctorId], references: [id])
  createdBy   User         @relation("CreatedByAppointments", fields: [createdById], references: [id])
  room        Room?        @relation("RoomAppointments", fields: [roomId], references: [id])
  transaction Transaction?

  @@index([doctorId])
  @@index([doctorId, date])
  @@map("TBLAGENDAMENTO")
}

model AppointmentType {
  id         String   @id @default(uuid())
  doctorId   String?
  name       String
  baseValue  Float?
  hasReturns Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor User? @relation("DoctorAppointmentTypes", fields: [doctorId], references: [id])

  @@map("TBLTIPOAGENDAMENTO")
}

model SqlQueryLog {
  id         String   @id @default(uuid())
  adminId    String
  query      String   @db.Text
  rowCount   Int?
  durationMs Int?
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminSqlLogs", fields: [adminId], references: [id])

  @@map("TBLLOGSQL")
}

model Transaction {
  id                  String            @id @default(uuid())
  doctorId            String
  appointmentId       String?           @unique
  type                TransactionType
  amount              Float
  description         String
  date                DateTime
  status              TransactionStatus @default(PENDING)
  category            String?
  categoryId          String?
  costCenterId        String?
  bankAccountId       String?
  paymentMethod       String?           @map("payment_method")
  paymentMethodId     String?
  repasseValue        Float?
  paidAt              DateTime?
  notes               String?
  reminderSent        Boolean           @default(false)
  overdueReminderSent Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  doctor            User               @relation(fields: [doctorId], references: [id])
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id])
  financialCategory FinancialCategory? @relation("CategoryTransactions", fields: [categoryId], references: [id])
  costCenter        CostCenter?        @relation("CostCenterTransactions", fields: [costCenterId], references: [id])
  bankAccount       BankAccount?       @relation("BankAccountTransactions", fields: [bankAccountId], references: [id])
  paymentMethodRef  PaymentMethod?     @relation("TransactionPaymentMethod", fields: [paymentMethodId], references: [id])

  @@map("TBLTRANSACAO")
}

model FinancialCategory {
  id        String          @id @default(uuid())
  doctorId  String
  name      String
  type      TransactionType
  color     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  doctor       User          @relation("DoctorFinancialCategories", fields: [doctorId], references: [id])
  transactions Transaction[] @relation("CategoryTransactions")

  @@map("TBLCATEGORIAFIN")
}

model CostCenter {
  id          String   @id @default(uuid())
  doctorId    String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor       User          @relation("DoctorCostCenters", fields: [doctorId], references: [id])
  transactions Transaction[] @relation("CostCenterTransactions")

  @@map("TBLCENTROCUSTO")
}

model BankAccount {
  id        String          @id @default(uuid())
  doctorId  String
  name      String
  bank      String?
  agency    String?
  account   String?
  type      BankAccountType @default(CHECKING)
  balance   Float           @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  doctor       User          @relation("DoctorBankAccounts", fields: [doctorId], references: [id])
  transactions Transaction[] @relation("BankAccountTransactions")

  @@map("TBLCONTABANCARIA")
}

model Room {
  id               String   @id @default(uuid())
  doctorId         String
  name             String
  logradouro       String?
  bairro           String?
  cep              String?
  numero           String?
  cidade           String?
  address          String?  @map("address")
  teleconsultaLink String?  @map("teleconsulta_link") // Link de teleconsulta para variável {teleconsulta}
  daysOfWeek       Json     @default("[]")
  startTime        String
  endTime          String
  color            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctor              User                    @relation("DoctorRooms", fields: [doctorId], references: [id])
  secretaries         RoomSecretary[]
  healthPlans         HealthPlan[]            @relation("RoomHealthPlans")
  appointments        Appointment[]           @relation("RoomAppointments")
  whatsappConnection  RoomWhatsAppConnection?
  patients            Patient[]               @relation("RoomPatients")
  chatbotLightBinding LightChatbot?           @relation("ChatbotLightRoomBinding")

  @@map("TBLSALA")
}

model RoomSecretary {
  id                      String   @id @default(uuid())
  roomId                  String
  secretaryId             String
  active                  Boolean  @default(true)
  // Granular room-level permissions
  canViewSchedule         Boolean  @default(true)
  canManageWhatsapp       Boolean  @default(false)
  canConnectWhatsapp      Boolean  @default(false)
  canReconnectWhatsapp    Boolean  @default(false)
  canDisconnectWhatsapp   Boolean  @default(false)
  canSendMessages         Boolean  @default(false)
  canUseTemplates         Boolean  @default(false)
  canUseAutomaticMessages Boolean  @default(false)
  canViewHistory          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  secretary User @relation("SecretaryRooms", fields: [secretaryId], references: [id])

  @@unique([roomId, secretaryId])
  @@index([secretaryId])
  @@map("TBLSALASECRETARIA")
}

// ─── Room WhatsApp Connection ─────────────────────────────────────────────────

model RoomWhatsAppConnection {
  id                String         @id @default(uuid())
  roomId            String         @unique
  doctorId          String
  instanceKey       String         @unique @default(uuid())
  status            InstanceStatus @default(DISCONNECTED)
  qrCode            String?        @db.Text
  qrCodeExpiresAt   DateTime?
  phoneNumber       String?
  displayName       String?
  connectedByUserId String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  lastSyncAt        DateTime?
  reconnectAttempts Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  room        Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  doctor      User  @relation("DoctorRoomConnections", fields: [doctorId], references: [id])
  connectedBy User? @relation("RoomWAConnectedBy", fields: [connectedByUserId], references: [id])

  @@index([doctorId])
  @@map("TBLSALAWHATSAPP")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  clinicId    String?
  roomId      String?
  userId      String
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([clinicId])
  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
  @@map("TBLAUDITLOG")
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  doctorId  String
  name      String
  type      String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation("DoctorDocuments", fields: [doctorId], references: [id])

  @@map("TBLMODELODOCUMENTO")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("TBLNOTIFICACAO")
}

model PaymentMethod {
  id           String   @id @default(uuid())
  doctorId     String
  name         String
  type         String
  instructions String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor       User          @relation("DoctorPaymentMethods", fields: [doctorId], references: [id])
  transactions Transaction[] @relation("TransactionPaymentMethod")

  @@map("TBLFORMAPAGAMENTO")
}

model Integration {
  id        String          @id @default(uuid())
  doctorId  String
  type      IntegrationType
  name      String
  active    Boolean         @default(false)
  config    Json            @default("{}")
  events    String[]        @default([])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  doctor      User         @relation("DoctorIntegrations", fields: [doctorId], references: [id], onDelete: Cascade)
  webhookLogs WebhookLog[]

  @@index([doctorId])
  @@map("TBLINTEGRACAO")
}

model WebhookLog {
  id            String   @id @default(uuid())
  integrationId String
  event         String
  payload       Json
  statusCode    Int?
  success       Boolean
  responseBody  String?
  error         String?
  duration      Int?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@map("TBLLOGWEBHOOK")
}

model DoctorSubscription {
  id                 String    @id @default(uuid())
  doctorId           String    @unique
  plan               String    @default("TRIAL")
  billingCycle       String    @default("MONTHLY")
  status             String    @default("ACTIVE")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  mpPaymentId        String?
  mpPreferenceId     String?
  trialWarned        Boolean   @default(false)
  adminNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  doctor   User                  @relation("DoctorSubscription", fields: [doctorId], references: [id])
  payments SubscriptionPayment[] @relation("SubPayments")

  @@map("TBLASSINATURA")
}

model SubscriptionPayment {
  id             String    @id @default(uuid())
  doctorId       String
  subscriptionId String
  plan           String
  billingCycle   String    @default("MONTHLY")
  amount         Float
  status         String    @default("PENDING")
  mpPaymentId    String?   @unique
  mpStatus       String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  doctor       User               @relation("DoctorPayments", fields: [doctorId], references: [id])
  subscription DoctorSubscription @relation("SubPayments", fields: [subscriptionId], references: [id])

  @@index([doctorId])
  @@index([mpPaymentId])
  @@map("TBLPAGAMENTOASSINATURA")
}

// ─── WhatsApp / Chatbot Module ────────────────────────────────────────────────

enum InstanceStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  QUARANTINED
}

enum ConversationStatus {
  OPEN
  CLOSED
  WAITING
  BOT
}

enum ConversationCategory {
  ATENDIMENTO
  AGUARDANDO
  FILA
  GRUPOS
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppInstanceType {
  CHATBOT_LIGHT
}

model WhatsAppInstance {
  id                 String               @id @default(uuid())
  doctorId           String
  type               WhatsAppInstanceType @default(CHATBOT_LIGHT)
  instanceKey        String               @unique @default(uuid())
  status             InstanceStatus       @default(DISCONNECTED)
  qrCode             String?              @db.Text
  qrCodeExpiresAt    DateTime?
  phoneNumber        String?
  displayName        String?
  webhookUrl         String?
  active             Boolean              @default(true)
  connectedAt        DateTime?
  disconnectedAt     DateTime?
  lastDisconnectCode Int?
  reconnectAttempts  Int                  @default(0)
  quarantinedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Vincula esta instância a um LightChatbot específico (multi-chatbot, jul/2026).
  chatbotId String? @unique

  doctor        User           @relation("DoctorWhatsApp", fields: [doctorId], references: [id])
  chatbot       LightChatbot?  @relation(fields: [chatbotId], references: [id])
  conversations Conversation[]

  @@map("TBLWHATSAPPINSTANCIA")
}

model LightChatbot {
  id            String   @id @default(uuid())
  doctorId      String
  name          String
  description   String?
  objective     String?
  active        Boolean  @default(true)
  // Uma sala só pode pertencer a 1 chatbot por vez — resolve a ambiguidade
  // de "que chatbot é dono desta sala?" no roteamento inbound.
  boundRoomId   String?  @unique
  fallbackQueue String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor       User                     @relation("DoctorLightChatbots", fields: [doctorId], references: [id])
  boundRoom    Room?                    @relation("ChatbotLightRoomBinding", fields: [boundRoomId], references: [id])
  instance     WhatsAppInstance?
  fluxos       LightFluxo[]
  quickReplies LightQuickReply[]
  integrations LightIntegrationConfig[]
  messageLogs  LightMessageLog[]

  @@index([doctorId])
  @@map("TBLLIGHTCHATBOT")
}

model WhatsAppMessageRetry {
  id          String   @id @default(uuid())
  instanceId  String
  remoteJid   String
  messageId   String
  fromMe      Boolean  @default(true)
  participant String?
  messageB64  String   @db.Text
  createdAt   DateTime @default(now())

  @@unique([instanceId, remoteJid, messageId, fromMe])
  @@index([instanceId])
  @@index([createdAt])
  @@map("TBLWHATSAPPMESSAGERETRY")
}

model Conversation {
  id                String               @id @default(uuid())
  instanceId        String
  contactPhone      String
  contactName       String?
  contactAvatar     String?
  status            ConversationStatus   @default(OPEN)
  category          ConversationCategory @default(ATENDIMENTO)
  isGroup           Boolean              @default(false)
  unreadCount       Int                  @default(0)
  lastMessage       String?
  lastMessageSender String?
  lastMessageAt     DateTime?
  assignedTo        String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // WhatsApp Identity fields
  remoteJid       String?
  deliveryJid     String?
  lidJid          String?
  phoneJid        String?
  normalizedPhone String?

  instance WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([instanceId])
  @@index([category])
  @@map("TBLCONVERSA")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  waMessageId    String? // WhatsApp message ID for deduplication and receipt tracking
  fromMe         Boolean       @default(false)
  senderName     String? // For group messages: who sent this message
  content        String        @db.Text
  type           MessageType   @default(TEXT)
  mediaUrl       String?
  status         MessageStatus @default(SENT)
  isBot          Boolean       @default(false)
  timestamp      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, waMessageId])
  @@index([conversationId])
  @@index([waMessageId])
  @@map("TBLMENSAGEM")
}

// ─── Chatbot Light Module ─────────────────────────────────────────────────────

model LightTemplate {
  id        String   @id @default(uuid())
  doctorId  String
  name      String
  category  String
  content   String   @db.Text
  variables String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor       User                     @relation("DoctorLightTemplates", fields: [doctorId], references: [id])
  integrations LightIntegrationConfig[]
  quickReplies LightQuickReply[]
  messageLogs  LightMessageLog[]

  @@index([doctorId])
  @@map("TBLCHATBOTLIGHTTEMPLATE")
}

model LightIntegrationConfig {
  id           String   @id @default(uuid())
  doctorId     String
  // A qual chatbot esta automação pertence — determina por qual sala/número
  // a mensagem é enviada quando o evento dispara. Nulo = chatbot padrão
  // herdado na migration de multi-chatbot (jul/2026).
  chatbotId    String?
  module       String
  triggerEvent String
  enabled      Boolean  @default(false)
  templateId   String?
  delayMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor   User           @relation("DoctorLightIntegrations", fields: [doctorId], references: [id])
  chatbot  LightChatbot?  @relation(fields: [chatbotId], references: [id])
  template LightTemplate? @relation(fields: [templateId], references: [id])

  @@unique([doctorId, chatbotId, module, triggerEvent])
  @@map("TBLCHATBOTLIGHTCONFIG")
}

model LightMessageLog {
  id            String    @id @default(uuid())
  doctorId      String
  // A qual chatbot este envio pertence — nulo para logs anteriores à
  // migration de multi-chatbot (jul/2026), sempre preenchido depois.
  chatbotId     String?
  phone         String
  recipientName String?
  content       String    @db.Text
  module        String
  triggerEvent  String?
  status        String    @default("PENDING")
  errorMessage  String?
  // Referência opcional ao LightTemplate usado para gerar a mensagem —
  // só gravado a partir de jul/2026 (Mensagens Automáticas e Respostas
  // Rápidas); envios de fluxo não gravam este campo.
  templateId    String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  doctor   User           @relation("DoctorLightLogs", fields: [doctorId], references: [id])
  chatbot  LightChatbot?  @relation(fields: [chatbotId], references: [id])
  template LightTemplate? @relation(fields: [templateId], references: [id])

  @@index([doctorId])
  @@index([doctorId, createdAt])
  @@index([chatbotId])
  @@map("TBLCHATBOTLIGHTLOG")
}

model LightSettings {
  id             String   @id @default(uuid())
  doctorId       String   @unique
  enabledScreens String[] @default(["agenda", "pacientes", "prontuario", "avaliacao", "financeiro"])
  // Exibe painéis avançados (Fluxos, Ações do Sistema, Simulador, Auditoria) no menu.
  advancedMode   Boolean  @default(false)
  // Horário de funcionamento — vale para todos os chatbots da conta.
  // Shape em chatbot-light-business-hours.ts (BusinessHoursConfig).
  businessHours  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor User @relation("DoctorLightSettings", fields: [doctorId], references: [id])

  @@map("TBLCHATBOTLIGHTSETTINGS")
}

model LightFluxo {
  id              String   @id @default(uuid())
  doctorId        String
  chatbotId       String?
  name            String
  description     String?
  keywords        String
  welcomeMessage  String   @db.Text
  options         Json     @default("[]")
  maxAttempts     Int      @default(3)
  fallbackMessage String   @default("Não consegui entender. Vou transferir para um atendente.") @db.Text
  active          Boolean  @default(true)
  executions      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor  User          @relation("DoctorLightFluxos", fields: [doctorId], references: [id])
  chatbot LightChatbot? @relation(fields: [chatbotId], references: [id])

  @@index([doctorId])
  @@index([chatbotId])
  @@map("TBLCHATBOTLIGHTFLUXO")
}

model LightQuickReply {
  id         String   @id @default(uuid())
  doctorId   String
  chatbotId  String?
  keyword    String
  response   String   @db.Text
  // Referência opcional a um LightTemplate — quando presente, o texto do
  // template prevalece sobre `response` na resolução da mensagem enviada.
  templateId String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor   User           @relation("DoctorLightQuickReplies", fields: [doctorId], references: [id])
  chatbot  LightChatbot?  @relation(fields: [chatbotId], references: [id])
  template LightTemplate? @relation(fields: [templateId], references: [id])

  @@index([doctorId])
  @@index([chatbotId])
  @@map("TBLCHATBOTLIGHTQUICKREPLY")
}

model LightNotificationTemplate {
  id        String   @id @default(uuid())
  doctorId  String
  name      String
  message   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation("DoctorLightNotifTemplates", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("TBLCHATBOTLIGHTNOTIFTPL")
}

model LightFlowSession {
  id              String    @id @default(uuid())
  instanceId      String
  conversationId  String?
  contactPhone    String
  flowId          String?
  actionConfigId  String?
  currentStepKey  String
  status          String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, FAILED, EXPIRED, TRANSFER
  source          String?   @default("WHATSAPP_CHATBOT_LIGHT")
  collectedData   Json? // Nome, Telefone, CPF, convenioId, serviceId, dataEscolhida, appointmentId
  dynamicOptions  Json? // Mapeamento dinâmico (ex: {"1": "service_id_X", "2": "slot_id_Y"})
  invalidAttempts Int       @default(0)
  lastMessageId   String?
  lastMessageAt   DateTime?
  expiresAt       DateTime?
  completedAt     DateTime?
  failedReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient Patient? @relation("ChatbotSessionPatient")

  @@index([instanceId, contactPhone, status])
  @@index([actionConfigId])
  @@index([expiresAt])
  @@map("TBLLIGHTFLOWSESSION")
}

model LightSystemActionConfig {
  id            String   @id @default(uuid())
  instanceId    String
  actionKey     String // Ex: SCHEDULE_APPOINTMENT
  name          String
  description   String?
  active        Boolean  @default(true)
  schemaVersion Int      @default(1)
  config        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([instanceId])
  @@index([actionKey])
  @@map("TBLLIGHTSYSTEMACTIONCONFIG")
}

model LightSystemActionLog {
  id             String   @id @default(uuid())
  instanceId     String
  actionConfigId String?
  actionKey      String
  conversationId String?
  contactPhone   String?
  sessionId      String?
  status         String // Ex: STARTED, INPUT_COLLECTED, COMPLETED, FAILED
  stepKey        String?
  message        String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([instanceId])
  @@index([actionConfigId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("TBLLIGHTSYSTEMACTIONLOG")
}
