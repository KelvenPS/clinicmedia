# Database
POSTGRES_USER=clinicuser
POSTGRES_PASSWORD=clinicpass_CHANGE_ME
POSTGRES_DB=clinicmedia

# JWT
JWT_SECRET=your-super-secret-jwt-key-CHANGE-ME-in-production

# Server
VPS_IP=2.25.185.223
NODE_ENV=production

BACKEND_URL=http://2.25.185.223
FRONTEND_URL=http://2.25.185.223

# WhatsApp Configuration
WA_SEND_GRACE_PERIOD_MS=15000
WA_RETRY_MESSAGE_TTL_DAYS=7

# Versionamento de build (preenchidos automaticamente pelo deploy.sh a partir do git;
# não é necessário setar manualmente em produção)
RELEASE_SHA=development
BUILD_DATE=

# Assinatura Clinic Pro (plano único, ver docs/assinatura-kiwify.md)
BILLING_PROVIDER=kiwify
CLINIC_PRO_MONTHLY_PRICE_CENTS=8990
CLINIC_PRO_CURRENCY=BRL
CLINIC_PRO_TRIAL_DAYS=7
CLINIC_PRO_GRACE_PERIOD_DAYS=0

# Feature flags de rollout — deixe ENFORCEMENT em false até configurar a Kiwify de verdade
SUBSCRIPTION_FEATURE_ENABLED=true
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
KIWIFY_WEBHOOK_ENABLED=true

# Kiwify (preencher no painel da conta — nunca commitar valores reais).
# Preferível: configure pelo menu Admin > Integrações no próprio app — o valor
# salvo no banco tem prioridade sobre estas env vars, que ficam só como
# fallback/compatibilidade para quem prefere configurar por redeploy.
KIWIFY_CHECKOUT_URL=
KIWIFY_PRODUCT_ID=
KIWIFY_ACCOUNT_ID=
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_WEBHOOK_SECRET=
KIWIFY_API_BASE_URL=
